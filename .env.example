# Copy to .env and adjust as needed. All values have sensible defaults.

# Port the Express server listens on
PORT=4000

# Where the SQLite file lives (defaults to server/data/wallet.db)
# DATABASE_PATH=./server/data/wallet.db

# Seed demo accounts/transactions/budgets automatically when the database is empty
# Set to "false" to start with an empty wallet (recommended in production)
AUTO_SEED=true

# How long a sign-in stays valid, in days
SESSION_DAYS=30

# Comma separated list of allowed browser origins for the API (defaults to same-origin only)
# CORS_ORIGIN=https://your-app.example.com

NODE_ENV=development
